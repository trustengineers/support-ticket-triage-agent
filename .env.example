# Copy to .env and fill in your key. Never commit .env.
ANTHROPIC_API_KEY=
# Only when calling the API through a proxy or gateway:
# ANTHROPIC_BASE_URL=

# The two models compared by eval.py. Swap freely; no code changes needed.
MODEL_A=claude-fable-5-2
MODEL_B=claude-haiku-5-5

# Price in USD per million tokens as "input,output". Needed only for models that
# are not in the built-in table in app/config.py; without it, cost shows as n/a.
MODEL_A_PRICE=
MODEL_B_PRICE=

# Model calls per ticket
MAX_STEPS=6
# Output cap per model call
MAX_TOKENS=8000
# "off" for models without adaptive thinking
THINKING_DISPLAY=summarized
DB_PATH=triage.db
